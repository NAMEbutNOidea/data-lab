{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动 DataLab（不自动开浏览器）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}",
      "env": {
        "MKL_THREADING_LAYER": "SEQUENTIAL",
        "KMP_DUPLICATE_LIB_OK": "TRUE",
        "DATALAB_NO_BROWSER": "1"
      },
      "justMyCode": true
    },
    {
      "name": "启动 DataLab（浏览器自动打开）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}",
      "env": {
        "MKL_THREADING_LAYER": "SEQUENTIAL",
        "KMP_DUPLICATE_LIB_OK": "TRUE"
      },
      "justMyCode": true
    }
  ]
}
